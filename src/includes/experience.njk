<div class="experience">
	<div class="experience__layout">
		{% for section in career %}
		<section id="{{ section.id }}" class="experience__section experience__section--{{ section.type }} js-scroll-{{ section.id }}">
			<h2 class="experience__section-title">{{ section.title }}</h2>
			<div class="experience__head" aria-hidden="true">
				<div class="experience__head-position">{{ section.positionLabel }}</div>
				<div class="experience__head-projects">Details</div>
			</div>
			<div class="experience__body">
				{% for item in section.items %}
				<article class="experience__item{% if not item.details.length %} experience__item--brief{% endif %}"{% if item.id %} id="{{ item.id }}"{% endif %}>
					<div class="experience__item-meta">
						<div class="experience__item-position">
							<h3 class="experience__item-position-title">{{ item.title }}</h3>
							{% if item.subtitle %}<p class="experience__item-position-desc">{{ item.subtitle }}</p>{% endif %}
						</div>
						<div class="experience__item-date"><span class="experience__item-date-period">{{ item.dates }}</span></div>
						<p class="experience__item-place-name">{{ item.place }}</p>
					</div>
					{% if item.details.length %}
					<div class="experience__item-projects">
						{% for detail in item.details %}<p>{{ detail }}</p>{% endfor %}
					</div>
					{% endif %}
				</article>
				{% endfor %}
			</div>
		</section>
		{% endfor %}
	</div>
</div>
