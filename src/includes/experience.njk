<div class="experience">
	<div class="experience__layout">
		{% for section in career %}
		<section id="{{ section.id }}" class="experience__section experience__section--{{ section.type }} js-scroll-{{ section.id }}">
			<h2 class="experience__section-title">{{ section.title }}</h2>
			<div class="experience__head" aria-hidden="true">
				<div class="experience__head-position">{{ section.positionLabel }}</div>
				<div class="experience__head-date">Date</div>
				<div class="experience__head-place">{{ section.placeLabel }}</div>
				<div class="experience__head-projects">Work / details</div>
			</div>
			<div class="experience__body">
				{% for item in section.items %}
				<div class="experience__item"{% if item.id %} id="{{ item.id }}"{% endif %}>
					<div class="experience__item-position">
						<div class="experience__item-position-title">{{ item.title }}</div>
						{% if item.subtitle %}<div class="experience__item-position-desc">{{ item.subtitle }}</div>{% endif %}
					</div>
					<div class="experience__item-date"><div class="experience__item-date-period">{{ item.dates }}</div></div>
					<div class="experience__item-place"><div class="experience__item-place-name">{{ item.place }}</div></div>
					<div class="experience__item-projects">
						{% for detail in item.details %}<p>{{ detail }}</p>{% endfor %}
					</div>
				</div>
				{% endfor %}
			</div>
		</section>
		{% endfor %}
	</div>
</div>
