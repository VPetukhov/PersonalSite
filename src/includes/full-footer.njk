<div class="request">
	<div class="request__layout">
		<div class="request__stain request__stain--top"></div>
		<div class="request__header section__header">
			<div class="request__title section__title">Let’s discuss your project</div>
			<div class="request__desc section__desc">Get in touch about AI engineering, computational biology or research collaborations. Early ideas are welcome too.</div>
			<div class="request__contacts-mail">
				<a class="request__contacts-mail-link" href="mailto:{{ metadata.mailto }}" target="_blank">{{ metadata.mailto }}</a>
				<div class="request__contacts-mail-copy js-clipboard" title="Copy email address" data-clipboard-text="{{ metadata.mailto }}"></div>
			</div>
		</div>
		<div class="request__body">
			<div class="request__summary">
				<div class="request__links">
					{% include "links.njk" %}
				</div>
			</div>
		</div>
	</div>
	<div class="request__stain request__stain--bottom"></div>
</div>
