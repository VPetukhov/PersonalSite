<div class="journey">
	<div class="journey__layout">
		<div class="journey__stain journey__stain--top"></div>
		<div class="journey__header"><h2 class="journey__title section__title">My journey</h2></div>
		<div class="journey__body">
			<div class="journey__list journey-list">
				{% for period in journey %}
				<div class="journey-list__item">
					<div class="journey-list__item-period"><div class="journey-list__item-period-date">{{ period.dates }}</div></div>
					{% for section in period.sections %}
					<div class="journey-list__item-section">
						{% if section.image %}
						<div class="journey-list__item-cover">
							<div class="journey-list__item-cover-container">
								<div class="journey-list__item-cover-layout"><img class="journey-list__item-cover-img" src="/img/{{ section.image }}" alt="" /></div>
							</div>
						</div>
						{% endif %}
						<div class="journey-list__item-desc">
							<div class="journey-list__item-content">
								{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
								{% if section.link %}<p><a href="{{ section.link }}">{{ section.linkTitle }}</a></p>{% endif %}
							</div>
						</div>
					</div>
					{% endfor %}
				</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>
